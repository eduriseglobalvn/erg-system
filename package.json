{
  "name": "react-erg-elerning-fe",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:vercel": "vite build",
    "test": "vitest run",
    "test:transport-integration": "vitest run src/test/api-graphql.integration.test.ts",
    "e2e": "playwright test",
    "e2e:lms": "playwright test --project=lms",
    "e2e:lcms": "playwright test --project=lcms",
    "e2e:crm": "playwright test --project=crm",
    "e2e:elearning": "playwright test --project=elearning",
    "contract:rest:sync": "node scripts/sync-api-contract.mjs",
    "contract:rest:generate": "openapi-typescript contracts/backend/erg-openapi.json -o src/lib/api/generated/erg-openapi.ts --alphabetize --immutable",
    "contract:rest:check": "node scripts/sync-api-contract.mjs --check",
    "contract:graphql:sync": "node scripts/sync-graphql-contract.mjs",
    "contract:graphql:check": "node scripts/sync-graphql-contract.mjs --check",
    "contract:check": "node --test scripts/api-contract-lib.test.mjs && bun run contract:rest:check && bun run contract:graphql:check && bun run graphql:operations:check",
    "plan-status:check": "node scripts/check-plan-status.mjs",
    "governance:check": "node scripts/check-plan-status.mjs && node scripts/check-cross-repo-governance.mjs",
    "repository-drift:check": "node scripts/check-frontend-repository-drift.mjs",
    "graphql:operations:check": "node scripts/check-graphql-operation-names.mjs",
    "verify:api-contract": "bun run contract:check && bun run typecheck && vitest run src/lib/api-client.test.ts src/lib/api/create-api-client.test.ts src/features/employee-management/api/employee-management-api.test.ts src/features/access-management/api/access-management-api.test.ts",
    "audit:legacy-ui": "node scripts/check-legacy-ui.mjs --baseline",
    "budget:check": "node scripts/check-bundle-budget.mjs",
    "budget:test": "node --test scripts/check-bundle-budget.test.mjs scripts/pwa-precache-policy.test.mjs",
    "desktop:readiness:check": "node scripts/check-desktop-readiness.mjs",
    "tauri:architecture:check": "node scripts/check-tauri-architecture.mjs",
    "tauri:info": "tauri info",
    "tauri:dev": "tauri dev",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri:build:no-bundle": "tauri build --no-bundle",
    "portable:build:web": "vite build --config vite.portable.config.ts",
    "portable:build": "node scripts/build-portable-exam.mjs",
    "portable:check": "node --test scripts/portable-exam-build.test.mjs",
    "desktop:release:check-env": "node scripts/desktop-release.mjs check-env",
    "desktop:release:prepare-config": "node scripts/desktop-release.mjs prepare-config",
    "desktop:release:build": "node scripts/desktop-release.mjs build",
    "desktop:release:sha256": "node scripts/desktop-release.mjs sha256",
    "desktop:release:manifest": "node scripts/desktop-release.mjs manifest",
    "desktop:release:feed": "node scripts/desktop-release.mjs feed",
    "audit:ui": "node scripts/playwright-ui-audit.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/manrope": "^5.2.8",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@mui/x-date-pickers": "9.5.0",
    "@tanstack/pacer": "^0.21.1",
    "@tanstack/query-async-storage-persister": "^5.100.11",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@tanstack/react-query-persist-client": "^5.100.11",
    "@tanstack/react-router": "^1.170.10",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.2",
    "@tanstack/store": "^0.11.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^1.11.0",
    "pdfjs-dist": "^5.7.284",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.2",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.9",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  }
}
