# Backend URL used by the Vite development proxy.
BACKEND_URL=http://localhost:8080

# Optional public API origin. Leave empty to call /api through the Vite proxy.
VITE_API_BASE=

# Firebase Cloud Messaging (web push, primary channel). Public web config, not secrets.
# Leave empty to keep push on VAPID Web Push only. Do not set a measurementId: Analytics is not used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
