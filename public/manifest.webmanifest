{
  "id": "/",
  "name": "ERG Learning",
  "short_name": "ERG",
  "description": "Ứng dụng học tập ERG dành cho giáo viên và học viên: lớp học, bài tập, lịch, kết quả và thông báo.",
  "lang": "vi-VN",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "theme_color": "#0f6cbd",
  "background_color": "#f8fafc",
  "categories": [
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Teacher Workspace",
      "short_name": "Giáo viên",
      "description": "Mở không gian làm việc dành cho giáo viên.",
      "url": "/teacher?source=pwa-shortcut",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Bài tập giáo viên",
      "short_name": "Giao bài",
      "description": "Mở nhanh kho bài tập và màn giao bài.",
      "url": "/teacher/homework?source=pwa-shortcut",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Student Workspace",
      "short_name": "Học viên",
      "description": "Mở không gian học tập dành cho học viên.",
      "url": "/student?source=pwa-shortcut",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Bài tập học viên",
      "short_name": "Làm bài",
      "description": "Mở nhanh danh sách bài tập của học viên.",
      "url": "/student?tab=assignments&source=pwa-shortcut",
      "icons": [
        {
          "src": "/android-chrome-192x192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "file_handlers": [
    {
      "action": "/?source=pwa-file-handler",
      "name": "ERG Quiz Package",
      "accept": {
        "application/x-ergquiz": [
          ".ergquiz"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ]
}
