{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "__ERG_PORTABLE_PRODUCT_NAME__",
  "version": "__ERG_PORTABLE_VERSION__",
  "identifier": "__ERG_PORTABLE_IDENTIFIER__",
  "build": {
    "frontendDist": "../dist-portable"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "__ERG_PORTABLE_PRODUCT_NAME__",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": true,
        "visible": true,
        "devtools": false
      }
    ],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis", "dmg"],
    "resources": ["../dist-portable/portable-exam.ergquiz"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
