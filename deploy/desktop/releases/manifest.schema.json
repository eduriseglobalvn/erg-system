{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://releases.erg.edu.vn/schemas/erg-lms-desktop-release-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "channel", "generatedAt", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": { "const": "erg-lms-desktop" },
    "channel": { "enum": ["stable", "beta", "internal"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "currentVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "revokedVersions": { "type": "array", "items": { "type": "string" }, "maxItems": 64 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "architecture", "installer", "version", "downloadUrl", "sha256", "signature", "sizeBytes", "rolloutPercent", "publishedAt"],
        "properties": {
          "platform": { "enum": ["windows", "darwin"] },
          "architecture": { "enum": ["x86_64", "aarch64"] },
          "installer": { "enum": ["nsis", "msi", "dmg"] },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
          "downloadUrl": { "type": "string", "pattern": "^https://(?:downloads|releases)\\.erg\\.edu\\.vn/" },
          "updaterDownloadUrl": { "type": "string", "pattern": "^https://(?:downloads|releases)\\.erg\\.edu\\.vn/" },
          "minimumRuntimeVersion": { "type": "string" },
          "notes": { "type": "string", "maxLength": 20000 },
          "sha256": { "type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$" },
          "signature": { "type": "string", "maxLength": 4096 },
          "updaterSignature": { "type": "string", "maxLength": 4096 },
          "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
          "rolloutPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
          "publishedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
